---
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))];
---

<Base title="News" description="Updates, competition recaps and newsletters from Spartronics 4915." fullWidth>
	<div class="wrap">
		<h1>News</h1>
		<nav class="years" aria-label="Jump to year">
			{years.map((year) => <a href={`#y${year}`}>{year}</a>)}
		</nav>
		{
			years.map((year) => (
				<section id={`y${year}`}>
					<h2>{year}</h2>
					<div class="grid">
						{posts
							.filter((post) => post.data.date.getUTCFullYear() === year)
							.map((post) => (
								<PostCard post={post} />
							))}
					</div>
				</section>
			))
		}
	</div>
</Base>

<style>
	.wrap {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 1.5rem 1rem 0;
	}
	.years {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.years a {
		padding: 0.2rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.95rem;
	}
	section {
		scroll-margin-top: 5rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 1.25rem;
	}
</style>
