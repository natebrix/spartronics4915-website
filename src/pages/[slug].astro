---
// Everything served at /<name>/ that isn't its own file in src/pages/:
// - news posts, from src/content/posts/ (the same URLs the WordPress site used)
// - simple pages, from src/content/pages/. Adding a Markdown file there adds a
//   page; no code needed. A page with its own file here (like join.astro) uses
//   that file instead, which reads the Markdown text itself.
import { getCollection } from 'astro:content';
import MarkdownPage from '../layouts/MarkdownPage.astro';
import Post from '../layouts/Post.astro';
import { getPosts } from '../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	// Pages with their own route file, like join.astro and history.astro.
	const customRoutes = new Set(Object.keys(import.meta.glob('./*.astro')).map((file) => file.slice(2, -'.astro'.length)));
	const pages = (await getCollection('pages')).filter((page) => !customRoutes.has(page.id));

	// Folders of routes, like news/ and sponsors/. A page can't share their name.
	const routeFolders = new Set(Object.keys(import.meta.glob('./*/**/*.astro')).map((file) => file.split('/')[1]));
	const postIds = new Set(posts.map((post) => post.id));
	for (const page of pages) {
		if (postIds.has(page.id) || routeFolders.has(page.id)) {
			throw new Error(`src/content/pages/${page.id}.md has the same name as another page or post. Rename the file.`);
		}
	}

	return [
		...posts.map((post, index) => ({
			params: { slug: post.id },
			props: { kind: 'post' as const, post, newer: posts[index - 1], older: posts[index + 1] },
		})),
		...pages.map((page) => ({
			params: { slug: page.id },
			props: { kind: 'page' as const, page },
		})),
	];
}

const props = Astro.props;
---

{props.kind === 'post' ? <Post post={props.post} newer={props.newer} older={props.older} /> : <MarkdownPage page={props.page} />}
