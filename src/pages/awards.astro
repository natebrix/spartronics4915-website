---
// Every award the team has won, one file per season in src/content/awards/.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const seasons = (await getCollection('awards')).sort((a, b) => b.data.year - a.data.year);
const total = seasons.reduce((sum, season) => sum + season.data.awards.length, 0);
---

<Base title="Awards" description="Every award Spartronics 4915 has won since our rookie season in 2014.">
	<p class="eyebrow">Since 2014</p>
	<h1>Awards</h1>
	<p class="lead">
		{total} awards and honors in {seasons.length} seasons of competition. Meet the robots that won them in{' '}
		<a href="/history/">Our History</a>.
	</p>
	{
		seasons.map((season) => (
			<section>
				<h2>
					{season.data.year}
					{season.data.note && <span class="note">{season.data.note}</span>}
				</h2>
				<ul>
					{season.data.awards.map((award) => (
						<li>{award}</li>
					))}
				</ul>
			</section>
		))
	}
</Base>

<style>
	.lead {
		font-size: 1.15rem;
	}
	section {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 1rem;
		padding: 1rem 0;
		border-top: 1px solid var(--line);
	}
	h2 {
		margin: 0;
		font-size: 1.4rem;
		color: var(--blue);
	}
	.note {
		display: block;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted);
	}
	ul {
		margin: 0;
		padding-left: 1.1rem;
	}
	@media (max-width: 480px) {
		section {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
