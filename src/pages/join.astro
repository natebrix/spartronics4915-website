---
// Text for this page is in src/content/pages/join.mdoc; subteams are in
// src/data/subteams.yaml.
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import teamPhoto from '../assets/home/team.jpg';
import SubteamCards from '../components/SubteamCards.astro';
import { TEAM_EMAIL } from '../consts';
import Base from '../layouts/Base.astro';
import { currentSeason } from '../lib/season';

const page = (await getEntry('pages', 'join'))!;
const { Content } = await render(page);
const season = currentSeason();
---

<Base title={page.data.title} description={page.data.description} image={teamPhoto} fullWidth>
	<section class="hero">
		<div class="text">
			<p class="eyebrow">Join us</p>
			<h1>{page.data.title}</h1>
			<p class="lead">
				High school students: come learn engineering, electronics, design, programming, or business and marketing
				in our {season.label} season. No experience needed. Stop by any meeting!
			</p>
			<p class="actions">
				<a class="button" href="/calendar/">See meeting dates</a>
				<a class="button secondary" href={`mailto:${TEAM_EMAIL}`}>Email us</a>
			</p>
		</div>
		<Image src={teamPhoto} alt="Spartronics programmers working on robot code" width={900} class="photo" loading="eager" />
	</section>

	<div class="wrap">
		<h2>Our subteams</h2>
		<SubteamCards />
		<div class="prose">
			<Content />
		</div>
	</div>
</Base>

<style>
	.hero {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 2rem 1rem 1rem;
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 2rem;
		align-items: center;
	}
	.lead {
		font-size: 1.15rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.photo {
		width: 100%;
		border-radius: var(--radius);
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.wrap {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 0 1rem;
	}
	.prose {
		max-width: var(--column);
		margin-top: 1rem;
	}
	@media (max-width: 760px) {
		.hero {
			grid-template-columns: 1fr;
			padding-top: 1rem;
		}
		.photo {
			order: -1;
		}
	}
</style>
