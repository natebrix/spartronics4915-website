---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="We couldn't find that page.">
	<section>
		<p class="eyebrow">404</p>
		<h1>We couldn't find that page</h1>
		<p>It may have moved when we rebuilt the website. Try one of these instead:</p>
		<p class="actions">
			<a class="button" href="/">Home</a>
			<a class="button secondary" href="/news/">All news</a>
		</p>
	</section>
</Base>

<style>
	section {
		text-align: center;
		padding: 3rem 0;
	}
	.actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
</style>
