---
// Text for this page, including meeting times, is in src/content/pages/calendar.mdoc.
import { getEntry, render } from 'astro:content';
import CalendarEmbed from '../components/CalendarEmbed.astro';
import { TEAM_EMAIL } from '../consts';
import Base from '../layouts/Base.astro';

const page = (await getEntry('pages', 'calendar'))!;
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
	<h1>{page.data.title}</h1>
	<Content />
	<CalendarEmbed />
	<p>Questions? Email us at <a href={`mailto:${TEAM_EMAIL}`}>{TEAM_EMAIL}</a>.</p>
</Base>
