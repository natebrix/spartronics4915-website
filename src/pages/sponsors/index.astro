---
import SponsorGrid from '../../components/SponsorGrid.astro';
import { DONATE_URL } from '../../consts';
import Base from '../../layouts/Base.astro';
---

<Base title="Our Sponsors" description="The businesses, organizations and families who make Spartronics 4915 possible." fullWidth>
	<div class="wrap">
		<p class="eyebrow">Thank you</p>
		<h1>Our Sponsors</h1>
		<p class="lead">
			Spartronics is grateful for all of our supporters. You help us spread STEAM education to students island-wide.
			If you are interested in becoming a sponsor or donating, we would love to hear from you.
		</p>
		<p class="actions">
			<a class="button" href={DONATE_URL}>Donate</a>
			<a class="button secondary" href="/sponsors/sponsor-information/">Become a sponsor</a>
		</p>
		<SponsorGrid />
	</div>
</Base>

<style>
	.wrap {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 1.5rem 1rem 0;
	}
	.lead {
		max-width: var(--column);
		font-size: 1.15rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 3rem;
	}
</style>
