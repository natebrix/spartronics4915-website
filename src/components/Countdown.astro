---
// Counts down to the event in src/data/countdown.ts. The page is built ahead of
// time, so a small script keeps the numbers live and hides the whole block
// once the event has started.
import { COUNTDOWN } from '../data/countdown';

const target = new Date(COUNTDOWN.date);
const units = ['Days', 'Hours', 'Minutes', 'Seconds'];
---

<section class="countdown" data-target={target.toISOString()} hidden>
	<h2>Countdown to {COUNTDOWN.name}</h2>
	<ol>
		{
			units.map((unit) => (
				<li>
					<span class="value" data-unit={unit}>
						–
					</span>
					<span class="label">{unit}</span>
				</li>
			))
		}
	</ol>
</section>

<script>
	for (const block of document.querySelectorAll<HTMLElement>('.countdown')) {
		const target = new Date(block.dataset.target ?? '').getTime();
		const values = block.querySelectorAll<HTMLElement>('.value');

		const tick = () => {
			const left = target - Date.now();
			if (!(left > 0)) {
				block.hidden = true;
				return false;
			}
			const seconds = Math.floor(left / 1000);
			const parts = [Math.floor(seconds / 86400), Math.floor(seconds / 3600) % 24, Math.floor(seconds / 60) % 60, seconds % 60];
			values.forEach((el, i) => (el.textContent = String(parts[i]).padStart(i === 0 ? 1 : 2, '0')));
			block.hidden = false;
			return true;
		};

		if (tick()) {
			const timer = setInterval(() => tick() || clearInterval(timer), 1000);
		}
	}
</script>

<style>
	.countdown {
		text-align: center;
		padding: 2rem 1rem;
		background: var(--ink);
		color: white;
	}
	.countdown[hidden] {
		display: none;
	}
	h2 {
		color: var(--yellow);
		margin: 0 0 1rem;
	}
	ol {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		min-width: 4.5rem;
	}
	.value {
		display: block;
		font-size: clamp(2rem, 7vw, 3rem);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		line-height: 1;
	}
	.label {
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(255 255 255 / 0.7);
	}
</style>
