---
// Cards for each subteam in src/data/subteams.yaml. A card shows a photo when
// src/assets/home/<subteam id>.jpg exists.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const subteams = (await getCollection('subteams')).sort((a, b) => a.data.order - b.data.order);
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/home/*.jpg', { eager: true });
const photoFor = (id: string) => photos[`../assets/home/${id}.jpg`]?.default;
---

<div class="grid">
	{
		subteams.map((team) => {
			const photo = photoFor(team.id);
			return (
				<article class="card">
					{photo && <Image src={photo} alt={`${team.data.name} subteam`} width={640} height={400} fit="cover" />}
					<div class="body">
						<h3>{team.data.name}</h3>
						<p>{team.data.summary}</p>
					</div>
				</article>
			);
		})
	}
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		gap: 1.25rem;
	}
	.card {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--paper);
	}
	img {
		width: 100%;
		aspect-ratio: 8 / 5;
		object-fit: cover;
		display: block;
	}
	.body {
		padding: 1rem 1.1rem 1.25rem;
	}
	h3 {
		margin: 0 0 0.5rem;
		color: var(--blue);
	}
	p {
		margin: 0;
		font-size: 0.97rem;
	}
</style>
