---
// A short, silent, looping video in place of a photo. It starts once it
// scrolls into view, never for visitors who ask for reduced motion, and has
// a pause button (moving content longer than five seconds needs one).
// Files go in public/video/: an .mp4 (H.264, no audio) and a .jpg poster.
interface Props {
	src: string;
	poster: string;
	// What the video shows, for screen readers.
	label: string;
}

const { src, poster, label } = Astro.props;
---

<div class="loop-video">
	<video src={src} poster={poster} muted loop playsinline preload="none" aria-label={label}></video>
	<button type="button" class="toggle" aria-label="Play video" hidden>
		<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
		<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"></path></svg>
	</button>
</div>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const wrapper of document.querySelectorAll<HTMLElement>('.loop-video')) {
		const video = wrapper.querySelector('video')!;
		const button = wrapper.querySelector('button')!;
		// Set once the visitor presses pause, so scrolling doesn't restart it.
		let pausedByVisitor = reduceMotion;

		const show = () => {
			button.setAttribute('aria-label', video.paused ? 'Play video' : 'Pause video');
			wrapper.classList.toggle('playing', !video.paused);
		};
		video.addEventListener('play', show);
		video.addEventListener('pause', show);
		button.hidden = false;
		button.addEventListener('click', () => {
			pausedByVisitor = !video.paused;
			if (video.paused) video.play().catch(() => {});
			else video.pause();
		});

		new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) video.pause();
			else if (!pausedByVisitor) video.play().catch(() => {});
		}).observe(video);
	}
</script>

<style>
	.loop-video {
		position: relative;
		height: 100%;
	}
	video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: inherit;
	}
	.toggle {
		position: absolute;
		right: 0.6rem;
		bottom: 0.6rem;
		width: 2.25rem;
		height: 2.25rem;
		display: grid;
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.55);
		color: #fff;
		cursor: pointer;
	}
	.toggle:hover {
		background: rgb(0 0 0 / 0.75);
	}
	.toggle svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: currentColor;
	}
	.icon-pause,
	.playing .icon-play {
		display: none;
	}
	.playing .icon-pause {
		display: block;
	}
</style>
