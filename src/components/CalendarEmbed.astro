---
// The team's Google Calendar (on the school district account).
const CALENDAR_ID = 'bisd303.org_cp3eue003cnnd60krqif751r7k@group.calendar.google.com';
const params = new URLSearchParams({ src: CALENDAR_ID, ctz: 'America/Los_Angeles' });
const embedUrl = `https://calendar.google.com/calendar/embed?${params}`;
const agendaUrl = `${embedUrl}&mode=AGENDA`;
---

<div class="calendar">
	<iframe class="month" src={embedUrl} title="Spartronics team calendar" loading="lazy"></iframe>
	<iframe class="agenda" src={agendaUrl} title="Spartronics team calendar (list)" loading="lazy"></iframe>
</div>
<p class="open">
	<a href={embedUrl}>Open the calendar in Google Calendar</a>
</p>

<style>
	.calendar iframe {
		width: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.month {
		height: 650px;
	}
	/* A month grid is unreadable on a phone; show the agenda view instead. */
	.agenda {
		display: none;
		height: 560px;
	}
	@media (max-width: 640px) {
		.month {
			display: none;
		}
		.agenda {
			display: block;
		}
	}
	.open {
		font-size: 0.95rem;
	}
</style>
