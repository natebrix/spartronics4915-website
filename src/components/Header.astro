---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { NAV_LINKS } from '../consts';

const current = Astro.url.pathname;
const isCurrent = (href: string) =>
	href === '/' ? current === '/' : current === href || (href !== '/sponsors/' && current.startsWith(href));
---

<header class="site-header">
	<div class="inner">
		<a class="brand" href="/">
			<Image src={logo} alt="" width={56} height={56} loading="eager" />
			<span>Spartronics <strong>4915</strong></span>
		</a>
		<button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
		<nav id="main-nav" aria-label="Main">
			<ul>
				{
					NAV_LINKS.map((link) => (
						<li>
							<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>('.menu-button');
	button?.addEventListener('click', () => {
		const open = button.getAttribute('aria-expanded') !== 'true';
		button.setAttribute('aria-expanded', String(open));
		document.getElementById('main-nav')?.classList.toggle('open', open);
	});
</script>

<style>
	.site-header {
		background: var(--blue);
		color: white;
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.inner {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 0.5rem 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: white;
		text-decoration: none;
		font-family: var(--font-heading);
		font-size: 1.35rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.brand strong {
		color: var(--yellow);
	}
	.brand img {
		width: 48px;
		height: 48px;
	}
	.menu-button {
		display: none;
	}
	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a {
		display: block;
		padding: 0.5rem 0.75rem;
		color: white;
		text-decoration: none;
		font-weight: 600;
		border-bottom: 3px solid transparent;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		border-bottom-color: var(--yellow);
	}

	/* On small screens the menu collapses behind a button. */
	@media (max-width: 960px) {
		.inner {
			position: relative;
		}
		.menu-button {
			display: block;
			cursor: pointer;
			background: none;
			color: white;
			font: inherit;
			padding: 0.5rem 0.9rem;
			border: 2px solid var(--yellow);
			border-radius: 6px;
			font-weight: 700;
		}
		nav {
			display: none;
			position: absolute;
			right: 1rem;
			top: 100%;
			background: var(--blue-dark);
			border-radius: 8px;
			padding: 0.5rem;
			min-width: 14rem;
			box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
		}
		nav.open {
			display: block;
		}
		nav ul {
			flex-direction: column;
		}
	}
</style>
