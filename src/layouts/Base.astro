---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	// Pages that lay out their own full-width sections (like the home page)
	// skip the default centered column.
	fullWidth?: boolean;
}

const { title, description, image, fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main" class={fullWidth ? undefined : 'column'}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
