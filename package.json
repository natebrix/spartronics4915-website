{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "npx serve dist",
    "postinstall": "nuxt prepare",
    "import:wordpress": "node ./scripts/import-wordpress.mjs",
    "check": "nuxt typecheck",
    "check:urls": "node ./scripts/check-old-urls.mjs",
    "check:site": "node ./scripts/check-site.mjs",
    "verify": "npm run check && npm run build && npm run check:site && npm run check:urls",
    "resolve:mailchimp": "node ./scripts/resolve-mailchimp-links.mjs",
    "deploy:demo": "npm run build && node ./scripts/mark-demo.mjs && wrangler pages deploy dist --project-name spartronics-demo --branch main"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "nuxt": "^4.6.3",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "nuxt-studio": "^1.8.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.1",
    "yaml": "^2.9.1"
  }
}
